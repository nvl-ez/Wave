<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:Wave.Ui.Pages.SettingsContent.Views"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.SettingsContent.ViewModels"
             xmlns:navigation="clr-namespace:Wave.Ui.Views.Navigation"
             x:Class="Wave.Ui.Pages.SettingsContent.SettingsPage"
             x:DataType="viewModels:SettingsViewModel"
             x:Name="Root"
             Title="Settings">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing"
                                        BindingContext="{Binding BindingContext, Source={x:Reference Root}, x:DataType=ContentPage}"
                                        Command="{Binding LoadCommand}"/>
    </ContentPage.Behaviors>

    <Grid Style="{StaticResource WavePageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <navigation:TabContainerView Grid.Row="0">
            <navigation:TabView Text="General"
                                Command="{Binding ShowGeneralViewCommand}"/>
            <navigation:TabView Text="Java"
                                Command="{Binding ShowJavaViewCommand}"/>
        </navigation:TabContainerView>

        <navigation:KeepAliveTabHost Grid.Row="1"
                                     CurrentTab="{Binding CurrentTab}">
            <views:GeneralView navigation:KeepAliveTabHost.TabKey="General"/>
            <views:JavaView navigation:KeepAliveTabHost.TabKey="Java"/>
        </navigation:KeepAliveTabHost>
    </Grid>
</ContentPage>

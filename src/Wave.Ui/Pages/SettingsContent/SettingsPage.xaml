<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:views="clr-namespace:Wave.Ui.Pages.SettingsContent.Views"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.SettingsContent.ViewModels"
             xmlns:navigation="clr-namespace:Wave.Ui.Views.Navigation"
             x:Class="Wave.Ui.Pages.SettingsContent.SettingsPage"
             x:DataType="viewModels:SettingsViewModel"
             Title="Settings">

    <Grid Style="{StaticResource WavePageGrid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <navigation:TabContainerView Grid.Row="0">
            <navigation:TabView Text="Java"/>
        </navigation:TabContainerView>

        <VerticalStackLayout Grid.Row="1"
                             toolkit:StateContainer.CurrentState="{Binding CurrentTab}">
            <toolkit:StateContainer.StateViews>
                <views:JavaView toolkit:StateView.StateKey="Java"/>
            </toolkit:StateContainer.StateViews>
            <views:JavaView/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>

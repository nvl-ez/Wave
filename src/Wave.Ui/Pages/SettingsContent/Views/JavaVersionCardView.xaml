<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:domain="clr-namespace:Wave.Domain.Java;assembly=Wave.Domain"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wave.Ui.Pages.SettingsContent.Views.JavaVersionCardView"
             x:DataType="domain:JavaVersion">
    <VerticalStackLayout>
        <Label Text="{Binding Name}"
               FontSize="20"/>
        <Label Text="{Binding Version, StringFormat='Major Version: {0}'}"/>
    </VerticalStackLayout>
</ContentView>

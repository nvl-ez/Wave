<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:domain="clr-namespace:Wave.Domain.Java;assembly=Wave.Domain"
             x:Class="Wave.Ui.Pages.SettingsContent.Views.JavaInstallationCardView"
             x:DataType="domain:JavaInstallation">

    <Border Style="{StaticResource WaveRaisedCard}"
            Padding="14">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    Style="{StaticResource WaveIconWell}">
                <Label Text="J"
                       FontAttributes="Bold"
                       FontSize="20"
                       TextColor="{AppThemeBinding Light={StaticResource WaveAccentLight}, Dark={StaticResource WaveAccentMutedDark}}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 VerticalOptions="Center">
                <Label Text="{Binding Name}"
                       Style="{StaticResource WaveCardTitle}"/>
                <Label Text="Installed runtime"
                       Style="{StaticResource WaveCardSubtitle}"/>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>

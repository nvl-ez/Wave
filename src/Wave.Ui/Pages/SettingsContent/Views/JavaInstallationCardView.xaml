<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:domain="clr-namespace:Wave.Domain.Java;assembly=Wave.Domain"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.SettingsContent.ViewModels"
             x:Class="Wave.Ui.Pages.SettingsContent.Views.JavaInstallationCardView"
             x:DataType="domain:JavaInstallation">

    <Border Style="{StaticResource WaveRaisedCard}"
            Padding="14">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Image Aspect="AspectFill">
                    <Image.Triggers>
                        <DataTrigger TargetType="Image"
                                     Binding="{Binding JavaSupplierType}"
                                     Value="{x:Static domain:JavaSupplierType.Mojang}">
                            <Setter Property="Source"
                                    Value="mojang.png"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Image"
                                     Binding="{Binding JavaSupplierType}"
                                     Value="{x:Static domain:JavaSupplierType.Adoptium}">
                            <Setter Property="Source"
                                    Value="adoptium.png"/>
                        </DataTrigger>
                    </Image.Triggers>
                </Image>
            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 VerticalOptions="Center">
                <Label Text="{Binding Name}"
                       Style="{StaticResource WaveCardTitle}"/>
                <Label Text="Installed runtime"
                       Style="{StaticResource WaveCardSubtitle}"/>
            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="Uninstall"
                    Style="{StaticResource WaveDangerButton}"
                    VerticalOptions="Center"
                    Command="{Binding UninstallJavaCommand,
                                      Source={RelativeSource AncestorType={x:Type viewModels:JavaViewModel}}}"
                    CommandParameter="{Binding .}"/>
        </Grid>
    </Border>
</ContentView>

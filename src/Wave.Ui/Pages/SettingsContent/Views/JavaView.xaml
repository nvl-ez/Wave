<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.SettingsContent.ViewModels"
             xmlns:views="clr-namespace:Wave.Ui.Pages.SettingsContent.Views"
             xmlns:domain="clr-namespace:Wave.Domain.Java;assembly=Wave.Domain"
             xmlns:out="clr-namespace:Wave.Application.Out.Java;assembly=Wave.Application"
             xmlns:page="clr-namespace:Wave.Ui.Pages.ExecutionContent"
             x:Class="Wave.Ui.Pages.SettingsContent.Views.JavaView"
             x:DataType="viewModels:JavaViewModel"
             x:Name="Root">

    <ContentView.Behaviors>
        <toolkit:EventToCommandBehavior
            x:DataType="viewModels:JavaViewModel"
            EventName="Loaded"
            BindingContext="{Binding BindingContext,
                                 Source={x:Reference Root},
                                 x:DataType=views:JavaView}"
            Command="{Binding LoadCommand}"/>
    </ContentView.Behaviors>

    <Grid RowSpacing="16"
          ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Text="Java Installation Manager"
               Style="{StaticResource WavePageTitle}"/>

        <!-- Java Installations -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource WaveSectionCard}">
        <VerticalStackLayout Spacing="14">
            <Label Text="Installed Java Versions"
                   Style="{StaticResource WaveSectionTitle}"/>
            <CollectionView ItemsSource="{Binding JavaInstallations}"
                            Margin="0"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="domain:JavaInstallation">
                        <views:JavaInstallationCardView/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
        </Border>

        <!-- Add Installation -->

        <Border Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource WaveSectionCard}">
        <VerticalStackLayout Spacing="12">
            <Label Text="Find and Download Java"
                   Style="{StaticResource WaveSectionTitle}"/>
            <!-- 1. Select Supplier -->
            <Border Style="{StaticResource WavePanelCard}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="1. Select Supplier"
                           Style="{StaticResource WaveFieldLabel}"/>
                    <CollectionView ItemsSource="{Binding JavaSuppliers}"
                                    Margin="0"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedJavaSupplier}"
                                    SelectionChangedCommand="{Binding JavaSupplierSelectedCommand}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout  Orientation="Vertical"
                                              Span="2"
                                              VerticalItemSpacing="2"
                                              HorizontalItemSpacing="2"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="out:IJavaSupplier">
                                <Border Style="{StaticResource WaveRaisedCard}"
                                        Padding="10">
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource WaveCardSubtitle}"
                                           HorizontalTextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 2. Query Version -->
            <Border IsVisible="{Binding QuerySectionIsVisible}"
                    Style="{StaticResource WavePanelCard}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="2. Select Major Version"
                           Style="{StaticResource WaveFieldLabel}"/>
                    <VerticalStackLayout toolkit:StateContainer.CurrentState="{Binding QuerySectionState}">
                        <toolkit:StateContainer.StateViews>
                            <!-- Loading -->
                            <Label toolkit:StateView.StateKey="Loading"
                                   Text="Loading"
                                   Style="{StaticResource WaveCardSubtitle}"/>
                            <!-- Loaded -->
                            <VerticalStackLayout toolkit:StateView.StateKey="Loaded"
                                                 Spacing="10">
                                <Picker ItemsSource="{Binding JavaVersionNumbers}"
                                        SelectedItem="{Binding SelectedJavaVersionNumber}"
                                        Style="{StaticResource WaveInputPicker}"/>
                                <Button Text="Search"
                                        Style="{StaticResource WavePrimaryButton}"
                                        Command="{Binding QueryVersionsCommand}"/>
                            </VerticalStackLayout>
                        </toolkit:StateContainer.StateViews>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 3. Display Versions -->
            <Border IsVisible="{Binding VersionsSectionIsVisible}"
                    Style="{StaticResource WavePanelCard}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="3. Select Version"
                           Style="{StaticResource WaveFieldLabel}"/>

                    <VerticalStackLayout toolkit:StateContainer.CurrentState="{Binding VersionsSectionState}">
                        <toolkit:StateContainer.StateViews>
                            <!-- Loading -->
                            <Label toolkit:StateView.StateKey="Loading"
                                   Text="Loading"
                                   Style="{StaticResource WaveCardSubtitle}"/>

                            <!-- Loaded -->
                            <VerticalStackLayout toolkit:StateView.StateKey="Loaded">
                                <CollectionView ItemsSource="{Binding JavaVersions}"
                                                Margin="0"
                                                SelectionMode="Single"
                                                SelectedItem="{Binding SelectedJavaVersion}"
                                                SelectionChangedCommand="{Binding JavaVersionSelectedCommand}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout  Orientation="Vertical"
                                                            ItemSpacing="2"/>
                                    </CollectionView.ItemsLayout>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="domain:JavaVersion">
                                            <views:JavaVersionCardView/>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </toolkit:StateContainer.StateViews>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Select a Download Option -->
            <Border IsVisible="{Binding ArtifactsSectionIsVisible}"
                    Style="{StaticResource WavePanelCard}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="4. Select Download Option"
                           Style="{StaticResource WaveFieldLabel}"/>
                    <CollectionView ItemsSource="{Binding JavaArtifacts}"
                                    Margin="0"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedJavaArtifact}"
                                    SelectionChangedCommand="{Binding JavaArtifactSelectedCommand}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout  Orientation="Horizontal"
                                                ItemSpacing="2"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:JavaArtifact">
                                <Border Style="{StaticResource WaveRaisedCard}"
                                        Padding="10">
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource WaveCardSubtitle}"/>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- 5. Download and Install -->
            <Border IsVisible="{Binding InstallSectionIsVisible}"
                    Style="{StaticResource WavePanelCard}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="5. Download and Install"
                           Style="{StaticResource WaveFieldLabel}"/>
                    <Button Text="GO"
                            Style="{StaticResource WaveSuccessButton}"
                            Command="{Binding DownloadAndInstallCommand}"
                            IsEnabled="{Binding IsInstallButtonEnabled}"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>

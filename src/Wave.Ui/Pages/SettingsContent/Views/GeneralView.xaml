<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.SettingsContent.ViewModels"
             xmlns:form="clr-namespace:Wave.Ui.Views.FormComponents"
             x:Class="Wave.Ui.Pages.SettingsContent.Views.GeneralView"
             x:DataType="viewModels:SettingsViewModel">

       <form:Form Model="{Binding Configuration}"
                  SubmitCommand="{Binding SaveConfigurationCommand}">
              <Grid RowDefinitions="*,Auto">
                     <ScrollView Grid.Row="0">
                            <VerticalStackLayout Spacing="16">
                                   <Label Text="General Settings"
                                          Style="{StaticResource WavePageTitle}"/>

                                   <Border Style="{StaticResource WaveSectionCard}">
                                          <VerticalStackLayout Spacing="10">
                                                 <Label Text="Default Java installation"
                                                        Style="{StaticResource WaveSectionTitle}"/>
                                                 <Label Text="Automatic selects the required Java version, or the lowest newer installed version."
                                                        Style="{StaticResource WaveCardSubtitle}"/>
                                                 <form:FormPicker ItemsSource="{Binding JavaInstallationOptions}"
                                                                  ItemDisplayBinding="{Binding Value}"
                                                                  SelectedValueMemberPath="Key"
                                                                  SelectedValueModelPath="JavaInstallation"/>
                                          </VerticalStackLayout>
                                   </Border>

                                   <Border Style="{StaticResource WaveSectionCard}">
                                          <VerticalStackLayout Spacing="12">
                                                 <Label Text="Mod suppliers"
                                                        Style="{StaticResource WaveSectionTitle}"/>
                                                 <Label Text="Add an API token to enable suppliers that require authentication."
                                                        Style="{StaticResource WaveCardSubtitle}"/>
                                                 <Label Text="CURSEFORGE API TOKEN"
                                                        Style="{StaticResource WaveMetaLabel}"/>
                                                 <form:FormEntry TextModelPath="CurseforgeApiToken"
                                                                 IsRequired="False"
                                                                 IsPassword="True"
                                                                 Placeholder="Optional"/>
                                          </VerticalStackLayout>
                                   </Border>
                            </VerticalStackLayout>
                     </ScrollView>

                     <form:SubmitButton Grid.Row="1"
                                        Text="Save"
                                        Style="{StaticResource WaveLargePrimaryButton}"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center"/>
              </Grid>
       </form:Form>
</ContentView>

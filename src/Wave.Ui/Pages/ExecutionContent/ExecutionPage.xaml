<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ExecutionContent.ViewModels"
             xmlns:page="clr-namespace:Wave.Ui.Pages.ExecutionContent"
             x:Class="Wave.Ui.Pages.ExecutionContent.ExecutionPage"
             x:DataType="viewModels:ExecutionViewModel"
             x:Name="Root"
             Title="{Binding Name, StringFormat='Server: {0}'}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            x:DataType="viewModels:ExecutionViewModel"
            EventName="Appearing"
            BindingContext="{Binding BindingContext,
                                 Source={x:Reference Root},
                                 x:DataType=page:ExecutionPage}"
            Command="{Binding LoadCommand}"/>
    </ContentPage.Behaviors>

    <Grid RowDefinitions="*,Auto"
          Padding="20"
          RowSpacing="12">
        <!-- The star-sized row keeps the log inside the available screen space. -->
        <CollectionView x:Name="LogsCollectionView"
                        Grid.Row="0"
                        ItemsSource="{Binding Logs}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Always">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="5"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Label Text="{Binding .}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Fixed command bar. -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="8">
            <Entry
                Grid.Column="0"
                Text="{Binding CommandMessage}"
                Placeholder="Enter a server command"
                IsEnabled="{Binding IsServerRunning}"
                ReturnType="Send"
                ReturnCommand="{Binding SendCommandCommand}"/>

            <Button Grid.Column="1"
                    Text="Send"
                    IsEnabled="{Binding CanSendCommand}"
                    Command="{Binding SendCommandCommand}"/>

            <!-- Stop and Start share the final position in the command bar. -->
            <Grid Grid.Column="2"
                  toolkit:StateContainer.CurrentState="{Binding ServerState}">
                <toolkit:StateContainer.StateViews>
                    <Button toolkit:StateView.StateKey="Running"
                            Text="Stop"
                            BackgroundColor="Red"
                            IsEnabled="{Binding CanStopServer}"
                            Command="{Binding StopServerCommand}"/>

                    <Button
                        toolkit:StateView.StateKey="Stopped"
                        Text="Start"
                        BackgroundColor="Green"
                        Command="{Binding StartServerCommand}"/>
                </toolkit:StateContainer.StateViews>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>

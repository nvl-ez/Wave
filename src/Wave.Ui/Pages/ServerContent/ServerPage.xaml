<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ServerContent.ViewModels"
             xmlns:navigation="clr-namespace:Wave.Ui.Views.Navigation"
             xmlns:views="clr-namespace:Wave.Ui.Pages.ServerContent.Views"
             xmlns:form="clr-namespace:Wave.Ui.Views.FormComponents"
             xmlns:page="clr-namespace:Wave.Ui.Pages.ServerContent"
             x:Class="Wave.Ui.Pages.ServerContent.ServerPage"
             x:DataType="viewModels:ServerViewModel"
             x:Name="Root"
             Title="{Binding TitleName, StringFormat='Server: {0}'}"
             BackgroundColor="{AppThemeBinding Light=#F5F7FB, Dark=#15171C}">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            x:DataType="viewModels:ServerViewModel"
            EventName="Appearing"
            BindingContext="{Binding BindingContext,
                                 Source={x:Reference Root},
                                 x:DataType=page:ServerPage}"
            Command="{Binding LoadCommand}"/>
    </ContentPage.Behaviors>

    <form:Form Model="{Binding Server}"
               SubmitCommand="{Binding SaveCommand}">
        <Grid Padding="28,22"
              RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <navigation:TabContainerView Grid.Row="0">
                <navigation:TabView Text="General"
                                    Command="{Binding ShowGeneralViewCommand}"/>
                <navigation:TabView Text="Mods"
                                    Command="{Binding ShowModsViewCommand}"/>
                <navigation:TabView Text="Properties"
                                    Command="{Binding ShowPropertiesViewCommand}"/>
            </navigation:TabContainerView>


            <navigation:KeepAliveTabHost Grid.Row="1"
                                         CurrentTab="{Binding CurrentTab}">
                <views:GeneralView navigation:KeepAliveTabHost.TabKey="General"/>
                <views:ModsView navigation:KeepAliveTabHost.TabKey="Mods"/>
                <views:PropertiesView navigation:KeepAliveTabHost.TabKey="Properties"/>
            </navigation:KeepAliveTabHost>


            <Border Grid.Row="2"
                    Stroke="{AppThemeBinding Light=#DEE6F3, Dark=#313844}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#20242C}"
                    Padding="14"
                    HorizontalOptions="Center">
                <HorizontalStackLayout
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Spacing="12">

                <form:SubmitButton Text="Save"/>

                <Button Text="Delete"
                        BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#4A2225}"
                        TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                        Command="{Binding DeleteCommand}"/>
                </HorizontalStackLayout>
            </Border>

        </Grid>
    </form:Form>
</ContentPage>

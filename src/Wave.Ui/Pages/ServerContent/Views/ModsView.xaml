<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ServerContent.ViewModels"
             xmlns:views="clr-namespace:Wave.Ui.Pages.ServerContent.Views"
             xmlns:form="clr-namespace:Wave.Ui.Views.FormComponents"
             xmlns:modloader="clr-namespace:Wave.Domain.ServerManager.Modloader;assembly=Wave.Domain"
             x:Class="Wave.Ui.Pages.ServerContent.Views.ModsView"
             x:DataType="viewModels:ServerViewModel"
             x:Name="Root">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modloader Section -->
        <Border Grid.Row="0"
                Style="{StaticResource WaveSectionCard}">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                       Text="Modloader"
                       Style="{StaticResource WaveSectionTitle}"/>

                <HorizontalStackLayout Grid.Row="1"
                                       Spacing="32"
                                       VerticalOptions="Center">
                    <form:Form HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               Model="{Binding ModloaderTypeQuery}"
                               SubmitCommand="{Binding RequestModloaderVersionsCommand}">
                        <HorizontalStackLayout Spacing="10">
                            <form:FormPicker WidthRequest="180"
                                             HeightRequest="44"
                                             ItemsSource="{Binding ModloaderTypes}"
                                             ItemDisplayBinding="{Binding Value}"
                                             SelectedValueModelPath="ModloaderType"
                                             SelectedValueMemberPath="Key"/>
                            <form:SubmitButton Text="Search"/>
                        </HorizontalStackLayout>
                    </form:Form>

                    <HorizontalStackLayout IsVisible="{Binding ModloaderInfoIsVisible}"
                                           Spacing="8"
                                           VerticalOptions="Center">
                        <Label Text="Version:"
                               VerticalOptions="Center"/>
                        <form:FormPicker WidthRequest="280"
                                         HeightRequest="44"
                                         ItemsSource="{Binding ModloaderInfos}"
                                         ItemDisplayBinding="{Binding Version}"
                                         SelectedValue="{Binding SelectedModloaderInfo}"/>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>

                <!-- Installed Modloader Card -->
                <Border Grid.Row="2"
                        IsVisible="{Binding InstalledModloaderIsVisible}"
                        Style="{StaticResource WaveSoftCard}">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource WaveShadowLight}, Dark={StaticResource Black}}"
                                Offset="0,5"
                                Radius="12"
                                Opacity="0.15"/>
                    </Border.Shadow>
                    <Grid ColumnSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                WidthRequest="70"
                                HeightRequest="70"
                                Style="{StaticResource WaveIconWell}"
                                Padding="4">
                            <Image Source="forge.png"
                                   Aspect="AspectFit"
                                   SemanticProperties.Description="Installed modloader">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image"
                                                 Binding="{Binding InstalledModloader.ModloaderType}"
                                                 Value="{x:Static modloader:ModloaderType.Forge}">
                                        <Setter Property="Source"
                                                Value="forge.png"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Image"
                                                 Binding="{Binding InstalledModloader.ModloaderType}"
                                                 Value="{x:Static modloader:ModloaderType.Fabric}">
                                        <Setter Property="Source"
                                                Value="fabric.png"/>
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                        </Border>

                        <HorizontalStackLayout Grid.Row="0"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Spacing="12"
                                               VerticalOptions="Center">
                            <Label Text="{Binding InstalledModloader.ModloaderType, StringFormat='{0} Modloader'}"
                                   FontSize="21"
                                   Style="{StaticResource WaveCardTitle}"/>
                            <Label Text="{Binding InstalledModloader.Version}"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource WaveAccentLight}, Dark={StaticResource WaveAccentDark}}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding InstalledModloader.MinecraftVersion, StringFormat='Minecraft {0}'}"
                               FontSize="14"
                               Style="{StaticResource WaveCardSubtitle}"/>

                        <Button Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="3"
                                Text="Remove"
                                Margin="10,0,0,0"
                                Style="{StaticResource WaveDangerButton}"
                                Command="{Binding RemoveModloaderCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Mods Section -->
        <Border Grid.Row="1"
                IsVisible="{Binding InstalledModloaderIsVisible}"
                Style="{StaticResource WaveSectionCard}">
            <Grid RowSpacing="14"
                  ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mods Header -->
                <Label Text="Installed Mods"
                       Grid.Row="0"
                       Grid.Column="0"
                       Style="{StaticResource WaveSectionTitle}"/>
                <Button Text="Add Mods"
                        Grid.Row="0"
                        Grid.Column="1"
                        Command="{Binding OpenModsPopupCommand}"/>
                <!-- Mod Version List -->
                <CollectionView Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                ItemsSource="{Binding Mods}"
                                SelectionMode="None">
                    <CollectionView.Triggers>
                        <DataTrigger TargetType="CollectionView"
                                     Binding="{Binding Mods.Count}"
                                     Value="0">
                            <Setter Property="IsVisible"
                                    Value="False"/>
                        </DataTrigger>
                    </CollectionView.Triggers>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ModCardViewModel">
                            <views:ModCardView/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout Grid.Row="1"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     IsVisible="False">
                    <VerticalStackLayout.Triggers>
                        <DataTrigger TargetType="VerticalStackLayout"
                                     Binding="{Binding Mods.Count}"
                                     Value="0">
                            <Setter Property="IsVisible"
                                    Value="True"/>
                        </DataTrigger>
                    </VerticalStackLayout.Triggers>

                    <Label Text="No mods added"
                           HorizontalTextAlignment="Center"
                           Style="{StaticResource WaveSectionTitle}"/>
                    <Label Text="Added mods will appear here."
                           HorizontalTextAlignment="Center"
                           Style="{StaticResource WaveCardSubtitle}"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Mods Unavailable Placeholder -->
        <Border Grid.Row="1"
                Style="{StaticResource WaveSectionCard}">
            <Border.Triggers>
                <DataTrigger TargetType="Border"
                             Binding="{Binding InstalledModloaderIsVisible}"
                             Value="True">
                    <Setter Property="IsVisible"
                            Value="False"/>
                </DataTrigger>
            </Border.Triggers>

            <VerticalStackLayout Spacing="8"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="Mods unavailable"
                       HorizontalTextAlignment="Center"
                       Style="{StaticResource WaveSectionTitle}"/>
                <Label Text="A modloader is required before you can add mods."
                       HorizontalTextAlignment="Center"
                       Style="{StaticResource WaveCardSubtitle}"/>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentView>

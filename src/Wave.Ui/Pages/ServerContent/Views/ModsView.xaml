<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ServerContent.ViewModels"
             xmlns:views="clr-namespace:Wave.Ui.Pages.ServerContent.Views"
             xmlns:form="clr-namespace:Wave.Ui.Views.FormComponents"
             xmlns:modloader="clr-namespace:Wave.Domain.ServerManager.Modloader;assembly=Wave.Domain"
             x:Class="Wave.Ui.Pages.ServerContent.Views.ModsView"
             x:DataType="viewModels:ServerViewModel"
             x:Name="Root">
    <ContentView.Resources>
        <Style TargetType="Label" x:Key="SectionTitle">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#172033, Dark=#F8FAFC}"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </ContentView.Resources>

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modloader Section -->
        <Border Grid.Row="0"
                Stroke="{AppThemeBinding Light=#DEE6F3, Dark=#313844}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#20242C}"
                Padding="16">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                       Text="Modloader"
                       Style="{StaticResource SectionTitle}"/>

                <HorizontalStackLayout Grid.Row="1"
                                       Spacing="12"
                                       VerticalOptions="Center">
                    <form:Form HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               Model="{Binding ModloaderTypeQuery}"
                               SubmitCommand="{Binding RequestModloaderVersionsCommand}">
                        <HorizontalStackLayout Spacing="10">
                            <form:FormPicker ItemsSource="{Binding ModloaderTypes}"
                                             ItemDisplayBinding="{Binding Value}"
                                             SelectedValueModelPath="ModloaderType"
                                             SelectedValueMemberPath="Key"/>
                            <form:SubmitButton Text="Search"/>
                        </HorizontalStackLayout>
                    </form:Form>

                    <form:FormPicker IsVisible="{Binding ModloaderInfoIsVisible}"
                                     ItemsSource="{Binding ModloaderInfos}"
                                     ItemDisplayBinding="{Binding Version}"
                                     SelectedValue="{Binding SelectedModloaderInfo}"/>
                </HorizontalStackLayout>

                <!-- Installed Modloader Card -->
                <Border Grid.Row="2"
                        IsVisible="{Binding InstalledModloaderIsVisible}"
                        Stroke="{AppThemeBinding Light=#BFD1EA, Dark=#38455A}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light=#F8FBFF, Dark=#202A38}"
                        Padding="14">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#B7C2D4, Dark=Black}"
                                Offset="0,5"
                                Radius="12"
                                Opacity="0.15"/>
                    </Border.Shadow>
                    <Grid ColumnSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                WidthRequest="70"
                                HeightRequest="70"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{AppThemeBinding Light=#DCE8FA, Dark=#324158}"
                                Padding="8">
                            <Image Source="forge.png"
                                   Aspect="AspectFit"
                                   SemanticProperties.Description="Installed modloader">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image"
                                                 Binding="{Binding InstalledModloader.ModloaderType}"
                                                 Value="{x:Static modloader:ModloaderType.Forge}">
                                        <Setter Property="Source" Value="forge.png"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Image"
                                                 Binding="{Binding InstalledModloader.ModloaderType}"
                                                 Value="{x:Static modloader:ModloaderType.Fabric}">
                                        <Setter Property="Source" Value="fabric.png"/>
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                        </Border>

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding InstalledModloader.ModloaderType, StringFormat='{0} Modloader'}"
                               FontAttributes="Bold"
                               FontSize="21"
                               TextColor="{AppThemeBinding Light=#172033, Dark=#F8FAFC}"/>

                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding InstalledModloader.MinecraftVersion, StringFormat='Minecraft {0}'}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#667085, Dark=#A8B0BF}"/>

                        <Label Grid.Row="0"
                               Grid.Column="2"
                               Text="{Binding InstalledModloader.Version}"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#2563EB, Dark=#9DBBFF}"
                               HorizontalOptions="End"/>

                        <Border Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="3"
                                Stroke="{AppThemeBinding Light=#FECACA, Dark=#6B2A2F}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 0,10,0,10"
                                Padding="4"
                                Margin="10,0,0,0">
                            <Button Text="Remove"
                                    TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                                    BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#4A2225}"
                                    Command="{Binding RemoveModloaderCommand}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Mods Section -->
        <Border Grid.Row="1"
                Stroke="{AppThemeBinding Light=#DEE6F3, Dark=#313844}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#20242C}"
                Padding="16">
        <Grid RowSpacing="14"
              ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Mods Header -->
            <Label Text="Installed Mods"
                   Grid.Row="0"
                   Grid.Column="0"
                   Style="{StaticResource SectionTitle}"/>
            <Button Text="Add Mods"
                    Grid.Row="0"
                    Grid.Column="1"
                    Command="{Binding OpenModsPopupCommand}"/>
            <!-- Mod Versi List -->
            <CollectionView Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            ItemsSource="{Binding Mods}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ModCardViewModel">
                        <views:ModCardView/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        </Border>

    </Grid>

</ContentView>

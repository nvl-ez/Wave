<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ServerContent.ViewModels"
             xmlns:views="clr-namespace:Wave.Ui.Pages.ServerContent.Views"
             xmlns:form="clr-namespace:Wave.Ui.Views.FormComponents"
             xmlns:modloader="clr-namespace:Wave.Domain.ServerManager.Modloader;assembly=Wave.Domain"
             x:Class="Wave.Ui.Pages.ServerContent.Views.ModsView"
             x:DataType="viewModels:ServerViewModel"
             x:Name="Root">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modloader Section -->
        <Border Grid.Row="0"
                Style="{StaticResource WaveSectionCard}">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                       Text="Modloader"
                       Style="{StaticResource WaveSectionTitle}"/>

                <HorizontalStackLayout Grid.Row="1"
                                       Spacing="12"
                                       VerticalOptions="Center">
                    <form:Form HorizontalOptions="Fill"
                               VerticalOptions="Fill"
                               Model="{Binding ModloaderTypeQuery}"
                               SubmitCommand="{Binding RequestModloaderVersionsCommand}">
                        <HorizontalStackLayout Spacing="10">
                            <form:FormPicker ItemsSource="{Binding ModloaderTypes}"
                                             ItemDisplayBinding="{Binding Value}"
                                             SelectedValueModelPath="ModloaderType"
                                             SelectedValueMemberPath="Key"/>
                            <form:SubmitButton Text="Search"/>
                        </HorizontalStackLayout>
                    </form:Form>

                    <form:FormPicker IsVisible="{Binding ModloaderInfoIsVisible}"
                                     ItemsSource="{Binding ModloaderInfos}"
                                     ItemDisplayBinding="{Binding Version}"
                                     SelectedValue="{Binding SelectedModloaderInfo}"/>
                </HorizontalStackLayout>

                <!-- Installed Modloader Card -->
                <Border Grid.Row="2"
                        IsVisible="{Binding InstalledModloaderIsVisible}"
                        Style="{StaticResource WaveSoftCard}">
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light={StaticResource WaveShadowLight}, Dark={StaticResource Black}}"
                                Offset="0,5"
                                Radius="12"
                                Opacity="0.15"/>
                    </Border.Shadow>
                    <Grid ColumnSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                WidthRequest="70"
                                HeightRequest="70"
                                Style="{StaticResource WaveIconWell}"
                                Padding="8">
                            <Image Source="forge.png"
                                   Aspect="AspectFit"
                                   SemanticProperties.Description="Installed modloader">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image"
                                                 Binding="{Binding InstalledModloader.ModloaderType}"
                                                 Value="{x:Static modloader:ModloaderType.Forge}">
                                        <Setter Property="Source" Value="forge.png"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Image"
                                                 Binding="{Binding InstalledModloader.ModloaderType}"
                                                 Value="{x:Static modloader:ModloaderType.Fabric}">
                                        <Setter Property="Source" Value="fabric.png"/>
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                        </Border>

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding InstalledModloader.ModloaderType, StringFormat='{0} Modloader'}"
                               FontSize="21"
                               Style="{StaticResource WaveCardTitle}"/>

                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding InstalledModloader.MinecraftVersion, StringFormat='Minecraft {0}'}"
                               FontSize="14"
                               Style="{StaticResource WaveCardSubtitle}"/>

                        <Label Grid.Row="0"
                               Grid.Column="2"
                               Text="{Binding InstalledModloader.Version}"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource WaveAccentLight}, Dark={StaticResource WaveAccentDark}}"
                               HorizontalOptions="End"/>

                        <Border Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="3"
                                Style="{StaticResource WaveDangerFrame}"
                                StrokeShape="RoundRectangle 0,10,0,10"
                                Margin="10,0,0,0">
                            <Button Text="Remove"
                                    Style="{StaticResource WaveDangerButton}"
                                    Command="{Binding RemoveModloaderCommand}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Mods Section -->
        <Border Grid.Row="1"
                Style="{StaticResource WaveSectionCard}">
        <Grid RowSpacing="14"
              ColumnSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Mods Header -->
            <Label Text="Installed Mods"
                   Grid.Row="0"
                   Grid.Column="0"
                   Style="{StaticResource WaveSectionTitle}"/>
            <Button Text="Add Mods"
                    Grid.Row="0"
                    Grid.Column="1"
                    Command="{Binding OpenModsPopupCommand}"/>
            <!-- Mod Versi List -->
            <CollectionView Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            ItemsSource="{Binding Mods}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ModCardViewModel">
                        <views:ModCardView/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        </Border>

    </Grid>

</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ServerContent.ViewModels"
             x:Class="Wave.Ui.Pages.ServerContent.Views.ModCardView"
             x:DataType="viewModels:ModCardViewModel">
    <Border Stroke="{AppThemeBinding Light=#DEE6F3, Dark=#313844}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            BackgroundColor="{AppThemeBinding Light=#FBFCFF, Dark=#252A33}"
            Padding="12">
    <Grid ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Mod Image -->
        <Image Source="{Binding Image}"
               SemanticProperties.Description="Mod Image"
               Grid.Column="0"
               Grid.Row="0"
               Grid.RowSpan="2"
               WidthRequest="70"
               HeightRequest="70"
               Aspect="AspectFill"/>
        <!-- Mod Name -->
        <Label Text="{Binding Name}"
               Grid.Row="0"
               Grid.Column="1"
               FontAttributes="Bold"
               FontSize="18"
               LineBreakMode="TailTruncation"
               TextColor="{AppThemeBinding Light=#172033, Dark=#F8FAFC}"/>
        <!-- Mod Description -->
        <Label Text="{Binding Summary}"
               Grid.Row="1"
               Grid.Column="1"
               Grid.ColumnSpan="2"
               FontSize="13"
               LineBreakMode="TailTruncation"
               MaxLines="2"
               TextColor="{AppThemeBinding Light=#667085, Dark=#A8B0BF}"/>
        <!-- Mod Version -->
        <Label Text="{Binding Version}"
               Grid.Row="0"
               Grid.Column="2"
               FontSize="12"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#2563EB, Dark=#9DBBFF}"/>
        <!-- Mod Supplier -->
        <Label Text="{Binding ModSupplier}"
               Grid.Row="0"
               Grid.Column="3"
               FontSize="12"
               TextColor="{AppThemeBinding Light=#667085, Dark=#A8B0BF}"
               HorizontalOptions="End"/>
        <!-- Mod Delete -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="4"
                IsVisible="{Binding CanDelete}"
                Stroke="{AppThemeBinding Light=#FECACA, Dark=#6B2A2F}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 0,10,0,10"
                Padding="5"
                Margin="10,0,0,0">
            <Button Text="Delete"
                    TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                    BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#4A2225}"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding DeleteCommandParameter}"/>
        </Border>
    </Grid>
    </Border>
</ContentView>

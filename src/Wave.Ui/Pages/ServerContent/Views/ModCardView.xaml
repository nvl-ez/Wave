<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ServerContent.ViewModels"
             x:Class="Wave.Ui.Pages.ServerContent.Views.ModCardView"
             x:DataType="viewModels:ModCardViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Mod Image -->
        <Image Source="{Binding Image}"
               SemanticProperties.Description="Mod Image"
               Grid.Column="0"
               Grid.Row="0"
               Grid.RowSpan="2"
               WidthRequest="70"
               HeightRequest="70"/>
        <!-- Mod Name -->
        <Label Text="{Binding Name}"
               Grid.Row="0"
               Grid.Column="1"
               FontAttributes="Bold"
               FontSize="22"/>
        <!-- Mod Description -->
        <Label Text="{Binding Summary}"
               Grid.Row="1"
               Grid.Column="1"
               Grid.ColumnSpan="2"
               FontSize="16"/>
        <!-- Mod Version -->
        <Label Text="{Binding Version}"
               Grid.Row="0"
               Grid.Column="2"/>
        <!-- Mod Supplier -->
        <Label Text="{Binding ModSupplier}"
               Grid.Row="0"
               Grid.Column="3"
               HorizontalOptions="End"/>
        <!-- Mod Delete -->
        <Border Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="4"
                IsVisible="{Binding HasModFile}"
                Stroke="Red"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 0,10,0,10"
                Padding="5"
                Margin="10,0,0,0">
            <Button Text="Delete"
                    TextColor="Red"
                    BackgroundColor="Transparent"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding DeleteCommandParameter}"/>
        </Border>
    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ServerContent.ViewModels"
             xmlns:views="clr-namespace:Wave.Ui.Pages.ServerContent.Views"
             xmlns:modloader="clr-namespace:Wave.Domain.ServerManager.Modloader;assembly=Wave.Domain"
             x:Class="Wave.Ui.Pages.ServerContent.Views.ChangesPopup"
             x:DataType="viewModels:ChangesPopupViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource WavePageBackgroundLight}, Dark={StaticResource WavePageBackgroundDark}}"
             MaximumWidthRequest="720">
        <Grid Padding="20"
              RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <VerticalStackLayout Grid.Row="0"
                                 Spacing="6">
                <Label Text="Server configuration changed"
                       FontSize="22"
                       Style="{StaticResource WaveSectionTitle}"/>
                <Label Text="Some changes to the server configuration require your attention."
                       FontSize="14"
                       Style="{StaticResource WaveCardSubtitle}"/>
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    IsVisible="{Binding HasDeletedModloader}"
                    Style="{StaticResource WaveSoftCard}">
                <Grid ColumnSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            WidthRequest="70"
                            HeightRequest="70"
                            Style="{StaticResource WaveIconWell}"
                            Padding="8">
                        <Image Source="forge.png"
                               Aspect="AspectFit"
                               SemanticProperties.Description="Removed modloader">
                            <Image.Triggers>
                                <DataTrigger TargetType="Image"
                                             Binding="{Binding DeletedModloader.ModloaderType}"
                                             Value="{x:Static modloader:ModloaderType.Forge}">
                                    <Setter Property="Source" Value="forge.png"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Image"
                                             Binding="{Binding DeletedModloader.ModloaderType}"
                                             Value="{x:Static modloader:ModloaderType.Fabric}">
                                    <Setter Property="Source" Value="fabric.png"/>
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                    </Border>

                    <Label Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding DeletedModloader.ModloaderType, StringFormat='{0} Modloader'}"
                           FontSize="21"
                           Style="{StaticResource WaveCardTitle}"/>

                    <Label Grid.Row="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding DeletedModloader.MinecraftVersion, StringFormat='Minecraft {0}'}"
                           FontSize="14"
                           Style="{StaticResource WaveCardSubtitle}"/>

                    <Label Grid.Row="0"
                           Grid.Column="2"
                           Text="{Binding DeletedModloader.Version}"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource WaveAccentLight}, Dark={StaticResource WaveAccentDark}}"
                           HorizontalOptions="End"/>
                </Grid>
            </Border>

            <ScrollView Grid.Row="2" MaximumHeightRequest="480">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout IsVisible="{Binding HasDeletedMods}" Spacing="10">
                        <Label Text="Removed Mods"
                               Style="{StaticResource WaveSectionTitle}"
                               FontSize="18"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DeletedMods}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ModCardViewModel">
                                    <views:ModCardView/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding HasFailedMods}" Spacing="10">
                        <Label Text="Mods that could not be installed"
                               Style="{StaticResource WaveSectionTitle}"
                               FontSize="18"/>
                        <Label Text="An error occurred while downloading these mods. They were not added to the server."
                               Style="{StaticResource WaveCardSubtitle}"
                               FontSize="14"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FailedMods}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ModCardViewModel">
                                    <views:ModCardView/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding HasIncompatibleMods}" Spacing="10">
                        <Label Text="Mods not installed due to incompatibilities"
                               Style="{StaticResource WaveSectionTitle}"
                               FontSize="18"/>
                        <Label Text="These mods, or one of their required dependencies, conflict with a mod already installed on the server."
                               Style="{StaticResource WaveCardSubtitle}"
                               FontSize="14"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding IncompatibleMods}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ModCardViewModel">
                                    <views:ModCardView/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding HasRequiredMods}" Spacing="10">
                        <Label Text="Automatically installed required mods"
                               Style="{StaticResource WaveSectionTitle}"
                               FontSize="18"/>
                        <Label Text="These mods were added because they are required dependencies."
                               Style="{StaticResource WaveCardSubtitle}"
                               FontSize="14"/>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RequiredMods}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ModCardViewModel">
                                    <views:ModCardView/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Button Grid.Row="3"
                    Text="Ok"
                    Style="{StaticResource WavePrimaryButton}"
                    Command="{Binding ConfirmCommand}"
                    HorizontalOptions="End"
                    WidthRequest="110"/>
        </Grid>
</ContentView>

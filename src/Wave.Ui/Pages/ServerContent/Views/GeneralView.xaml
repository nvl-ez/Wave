<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ServerContent.ViewModels"
             xmlns:views="clr-namespace:Wave.Ui.Pages.ServerContent.Views"
             xmlns:form="clr-namespace:Wave.Ui.Views.FormComponents"
             x:Class="Wave.Ui.Pages.ServerContent.Views.GeneralView"
             x:DataType="viewModels:ServerViewModel">
       <ContentView.Resources>
              <Style TargetType="Label" x:Key="FieldLabel">
                     <Setter Property="FontSize" Value="13"/>
                     <Setter Property="FontAttributes" Value="Bold"/>
                     <Setter Property="TextColor" Value="{AppThemeBinding Light=#475467, Dark=#BAC3D1}"/>
                     <Setter Property="VerticalOptions" Value="Center"/>
                     <Setter Property="Margin" Value="0,0,8,0"/>
              </Style>
              <Style TargetType="Border" x:Key="SectionCard">
                     <Setter Property="Stroke" Value="{AppThemeBinding Light=#DEE6F3, Dark=#313844}"/>
                     <Setter Property="StrokeThickness" Value="1"/>
                     <Setter Property="StrokeShape" Value="RoundRectangle 8"/>
                     <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#20242C}"/>
                     <Setter Property="Padding" Value="18"/>
              </Style>
       </ContentView.Resources>

       <VerticalStackLayout Spacing="18">
              <!-- Icon, Name and MOTD !-->
              <Border Style="{StaticResource SectionCard}">
              <Grid ColumnSpacing="16"
                    RowSpacing="12">
                     <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                     </Grid.RowDefinitions>
                     <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                     </Grid.ColumnDefinitions>

                     <Border Grid.Column="0"
                             Grid.RowSpan="2"
                             Grid.Row="0"
                             WidthRequest="104"
                             HeightRequest="104"
                             StrokeThickness="0"
                             StrokeShape="RoundRectangle 8"
                             BackgroundColor="{AppThemeBinding Light=#EAF1FF, Dark=#29344A}"
                             ToolTipProperties.Text="Preferred image size: 64 x 64 pixels">
                            <Border.GestureRecognizers>
                                   <TapGestureRecognizer Command="{Binding SelectServerIconCommand}"/>
                                   <PointerGestureRecognizer PointerEnteredCommand="{Binding ShowServerIconOverlayCommand}"
                                                             PointerExitedCommand="{Binding HideServerIconOverlayCommand}"/>
                            </Border.GestureRecognizers>
                            <Grid>
                                   <Image Source="{Binding ServerIcon}"
                                          Aspect="AspectFill"/>
                                   <Border StrokeThickness="0"
                                           BackgroundColor="#80000000"
                                           IsVisible="{Binding ServerIconIsPointerOver}">
                                          <Label Text="+"
                                                 FontAttributes="Bold"
                                                 FontSize="42"
                                                 TextColor="White"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"/>
                                   </Border>
                            </Grid>
                     </Border>

                     <!-- Name -->
                     <Label Grid.Column="1"
                            Grid.Row="0"
                            Style="{StaticResource FieldLabel}"
                            Text="Server name"/>
                     <form:FormEntry Grid.Column="2"
                                     Grid.Row="0"
                                     TextModelPath="Name"
                                     IsRequired="True"/>

                     <!-- Motd -->
                     <Label Grid.Column="1"
                            Grid.Row="1"
                            Style="{StaticResource FieldLabel}"
                            Text="Motd"/>
                     <views:ServerPropertyInputView Grid.Column="2"
                                                    Grid.Row="1"
                                                    ServerPropertyKey="motd"
                                                    PropertyDictionaryModelPath="Properties"
                                                    ServerPropertyDefinition="{Binding MotdServerProperty}"/>
              </Grid>
              </Border>

              <!-- General Properties !-->
              <Border Style="{StaticResource SectionCard}">
              <Grid ColumnSpacing="16"
                    RowSpacing="14">
                     <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                     </Grid.RowDefinitions>
                     <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                     </Grid.ColumnDefinitions>

                     <!-- Versions -->
                     <Label Grid.Column="0"
                            Grid.Row="0"
                            Style="{StaticResource FieldLabel}"
                            Text="Versions:"/>
                     <HorizontalStackLayout Grid.Row="0"
                                            Grid.Column="1"
                                            Spacing="10"
                                            VerticalOptions="Center">
                            <VerticalStackLayout
                                   toolkit:StateContainer.CurrentState="{Binding MinecraftVersionsStatus}">
                                   <toolkit:StateContainer.StateViews>
                                          <form:FormPicker toolkit:StateView.StateKey="Done"
                                                           ItemsSource="{Binding MinecraftVersionsInfos}"
                                                           ItemDisplayBinding="{Binding MinecraftVersion}"
                                                           SelectedValueModelPath="MinecraftVersionBase"
                                                           IsRequired="True"/>

                                          <BoxView toolkit:StateView.StateKey="Error"
                                                   WidthRequest="200"
                                                   HeightRequest="50"
                                                   Color="Red"/>
                                          <BoxView toolkit:StateView.StateKey="Loading"
                                                   WidthRequest="200"
                                                   HeightRequest="50"/>
                                   </toolkit:StateContainer.StateViews>

                                   <BoxView WidthRequest="200"
                                            HeightRequest="50"/>
                            </VerticalStackLayout>
                            <Label Text="Include Snapshots"
                                   Style="{StaticResource FieldLabel}"/>
                            <form:FormCheckBox IsChecked="{Binding IncludeSnapshots}"
                                               Command="{Binding RequestMinecraftVersionsCommand}"/>
                     </HorizontalStackLayout>

                     <!-- Gamemode -->
                     <Label Grid.Column="2"
                            Grid.Row="0"
                            Style="{StaticResource FieldLabel}"
                            Text="Gamemode:"/>
                     <views:ServerPropertyInputView Grid.Column="3"
                                                    Grid.Row="0"
                                                    ServerPropertyDefinition="{Binding GamemodeServerProperty}"
                                                    PropertyDictionaryModelPath="Properties"/>

                     <!-- Server IP -->
                     <Label Grid.Column="0"
                            Grid.Row="1"
                            Style="{StaticResource FieldLabel}"
                            Text="Server IP:"/>
                     <views:ServerPropertyInputView Grid.Column="1"
                                                    Grid.Row="1"
                                                    ServerPropertyDefinition="{Binding ServerIpServerProperty}"
                                                    PropertyDictionaryModelPath="Properties"/>

                     <!-- Max Players -->
                     <Label Grid.Column="2"
                            Grid.Row="1"
                            Style="{StaticResource FieldLabel}"
                            Text="Max Players:"/>
                     <views:ServerPropertyInputView Grid.Column="3"
                                                    Grid.Row="1"
                                                    ServerPropertyDefinition="{Binding MaxPlayersServerProperty}"
                                                    PropertyDictionaryModelPath="Properties"/>

                     <!-- Difficulty -->
                     <Label Grid.Column="0"
                            Grid.Row="2"
                            Style="{StaticResource FieldLabel}"
                            Text="Difficulty:"/>
                     <views:ServerPropertyInputView Grid.Column="1"
                                                    Grid.Row="2"
                                                    ServerPropertyDefinition="{Binding DifficultyServerProperty}"
                                                    PropertyDictionaryModelPath="Properties"/>

                     <!-- Eula -->
                     <Label Grid.Column="2"
                            Grid.Row="2"
                            Style="{StaticResource FieldLabel}"
                            Text="Eula:"/>
                     <form:FormPicker Grid.Column="3"
                                      Grid.Row="2"
                                      ItemsSource="{Binding EulaOptions}"
                                      ItemDisplayBinding="{Binding Value}"
                                      SelectedValueMemberPath="Key"
                                      SelectedValueModelPath="Eula"/>
              </Grid>
              </Border>

              <!-- Execution flags -->
              <Border Style="{StaticResource SectionCard}">
                     <VerticalStackLayout Spacing="10">
                            <Label Style="{StaticResource FieldLabel}"
                                   Text="Execution flags"/>
                            <form:FormEntry TextModelPath="ExecutionFlags"
                                            HorizontalOptions="Fill"
                                            Placeholder="-Xms1G -Xmx2G"/>
                     </VerticalStackLayout>
              </Border>

       </VerticalStackLayout>
</ContentView>

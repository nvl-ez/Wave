<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ServerContent.ViewModels"
             xmlns:views="clr-namespace:Wave.Ui.Pages.ServerContent.Views"
             xmlns:collectionComponents="clr-namespace:Wave.Ui.Views.CollectionComponents"
             xmlns:form="clr-namespace:Wave.Ui.Views.FormComponents"
             xmlns:domain="clr-namespace:Wave.Domain.Mods;assembly=Wave.Domain"
             x:Class="Wave.Ui.Pages.ServerContent.Views.ModsPopup"
             x:DataType="viewModels:ModsPopupViewModel"
             x:Name="Root"
             BackgroundColor="{AppThemeBinding Light={StaticResource WavePageBackgroundLight}, Dark={StaticResource WavePageBackgroundDark}}"
             MinimumWidthRequest="1100"
             MinimumHeightRequest="720"
             WidthRequest="1700">

    <ContentView.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Loaded"
                                        BindingContext="{Binding BindingContext, Source={x:Reference Root}, x:DataType=views:ModsPopup}"
                                        Command="{Binding LoadCommand}"/>
    </ContentView.Behaviors>

    <Grid Padding="26,22"
            RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.8*"/>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="1.45*"/>
        </Grid.ColumnDefinitions>

        <VerticalStackLayout Grid.Row="0"
                Grid.ColumnSpan="3"
                Spacing="3">
            <Label Text="Mod Browser"
                    Style="{StaticResource WavePageTitle}"/>
            <Label Text="Find compatible mods, choose a version, and review your selection before saving."
                   Style="{StaticResource WaveCardSubtitle}"
                    FontSize="14"/>
        </VerticalStackLayout>

        <Border Grid.Row="1"
                Grid.ColumnSpan="3"
                Style="{StaticResource WavePanelCard}">
            <form:Form Model="{Binding ModInfoSupplierQuery}"
                    SubmitCommand="{Binding SearchModsCommand}">
                <Grid ColumnSpacing="12"
                        RowSpacing="6"
                        ColumnDefinitions="1.2*,5*,2*,Auto"
                        RowDefinitions="Auto,Auto">
                    <Label Text="MOD SUPPLIER"
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource WaveMetaLabel}"/>
                    <form:FormPicker Grid.Row="1"
                            Grid.Column="0"
                            IsRequired="True"
                                     ItemsSource="{Binding ModSupplierTypes}"
                            ItemDisplayBinding="{Binding Value}"
                                     SelectedValueMemberPath="Key"
                            SelectedValueModelPath="ModSupplierType"/>
                    <Label Text="SEARCH"
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource WaveMetaLabel}"/>
                    <form:FormEntry Grid.Row="1"
                            Grid.Column="1"
                            TextModelPath="TextQuery"/>
                    <Label Text="AUTHOR"
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource WaveMetaLabel}"/>
                    <form:FormEntry Grid.Row="1"
                            Grid.Column="2"
                            TextModelPath="Author"/>
                    <form:SubmitButton Text="Search mods"
                            Grid.Row="1"
                            Grid.Column="3"/>
                </Grid>
            </form:Form>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="3"
                Style="{StaticResource WavePanelCard}"
                IsVisible="{Binding HasSearched}">
            <Grid ColumnSpacing="16"
                    ColumnDefinitions="1.8*,2.2*,1.45*">
                <collectionComponents:PaginatedCollectionView Grid.Column="0"
                        x:Name="ModsCollection"
                                                              NavigateCommand="{Binding PaginatedSearchModsCommand}"
                                                              PaginationState="{Binding ObservablePaginationState}"
                                                              ItemsSource="{Binding ModInfos}"
                        SelectionMode="Single"
                                                              SelectionChangedCommand="{Binding GetModDetailsWithModInfoCommand}"
                                                              SelectionChangedCommandParameter="{Binding Source={x:Reference ModsCollection}, Path=SelectedItem.ModInfo}">
                    <collectionComponents:PaginatedCollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                ItemSpacing="10"/>
                    </collectionComponents:PaginatedCollectionView.ItemsLayout>
                    <collectionComponents:PaginatedCollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ModCardViewModel">
                            <views:ModCardView/>
                        </DataTemplate>
                    </collectionComponents:PaginatedCollectionView.ItemTemplate>
                </collectionComponents:PaginatedCollectionView>

                <Grid Grid.Column="1">
                    <VerticalStackLayout HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="8">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout"
                                    Binding="{Binding HasSelectedMod}"
                                    Value="True">
                                <Setter Property="IsVisible"
                                        Value="False"/>
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>
                        <Label Text="Select a mod"
                                Style="{StaticResource WaveSectionTitle}"
                                HorizontalTextAlignment="Center"/>
                        <Label Text="Choose a mod from the results to view its details and available versions."
                               Style="{StaticResource WaveCardSubtitle}"
                                FontSize="14"
                                HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                    <Grid RowSpacing="14"
                            IsVisible="{Binding HasSelectedMod}"
                            RowDefinitions="Auto,*,Auto">
                        <HorizontalStackLayout Spacing="14"
                                VerticalOptions="Center">
                            <Border Style="{StaticResource WaveIconWell}"
                                    Padding="5"
                                    WidthRequest="86"
                                    HeightRequest="86">
                                <Image Source="{Binding ModIconUrl}"
                                        Aspect="AspectFill"/>
                            </Border>
                            <Label Text="{Binding ModName}"
                                    FontSize="24"
                                    Style="{StaticResource WaveCardTitle}"
                                    VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border Grid.Row="1"
                                Style="{StaticResource WaveRaisedCard}"
                                BackgroundColor="{StaticResource WaveInputDark}"
                                Padding="10">
                            <Grid toolkit:StateContainer.CurrentState="{Binding ModDescriptionType}">
                                <toolkit:StateContainer.StateViews>
                                    <WebView toolkit:StateView.StateKey="Html"
                                            BackgroundColor="{StaticResource WaveInputDark}">
                                        <WebView.Source>
                                            <HtmlWebViewSource Html="{Binding ModDescription}"/>
                                        </WebView.Source>
                                    </WebView>
                                    <Editor toolkit:StateView.StateKey="Text"
                                            IsReadOnly="True"
                                            Text="{Binding ModDescription}"
                                            FontSize="14"/>
                                    <ActivityIndicator toolkit:StateView.StateKey="Loading"
                                            IsRunning="True"/>
                                </toolkit:StateContainer.StateViews>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2"
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="10">
                            <Label Text="VERSION"
                                    Style="{StaticResource WaveMetaLabel}"
                                    VerticalOptions="Center"/>
                            <Picker Grid.Column="1"
                                    Style="{StaticResource WaveInputPicker}"
                                    ItemsSource="{Binding ModVersions}"
                                    ItemDisplayBinding="{Binding VersionName}"
                                    SelectedItem="{Binding CurrentModVersion}"/>
                            <Button Grid.Column="2"
                                    Text="Add mod"
                                    Style="{StaticResource WavePrimaryButton}"
                                    Command="{Binding AddModFileCommand}"/>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Column="2"
                        RowDefinitions="Auto,*,Auto"
                        RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Selected mods"
                                Style="{StaticResource WaveSectionTitle}"/>
                        <Border Grid.Column="1"
                                Style="{StaticResource WaveIconWell}"
                                Padding="10,4">
                            <Label Text="{Binding ModFiles.Count}"
                                    FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource WaveAccentLight}, Dark={StaticResource WaveAccentDark}}"/>
                        </Border>
                    </Grid>
                    <CollectionView Grid.Row="1"
                            ItemsSource="{Binding ModFiles}"
                            SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                                    ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="domain:ModFile">
                                <Border Style="{StaticResource WaveRaisedCard}"
                                        Padding="10">
                                    <Grid ColumnDefinitions="54,*,Auto"
                                            ColumnSpacing="10">
                                        <Border Style="{StaticResource WaveIconWell}"
                                                WidthRequest="54"
                                                HeightRequest="54"
                                                Padding="3">
                                            <Image Source="{Binding IconUrl}"
                                                    Aspect="AspectFill"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1"
                                                Spacing="2"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding ModName}"
                                                    Style="{StaticResource WaveCardTitle}"
                                                    FontSize="15"
                                                   LineBreakMode="WordWrap"
                                                    MaxLines="2"/>
                                            <Label Text="{Binding VersionName}"
                                                    Style="{StaticResource WaveCardSubtitle}"
                                                    FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2"
                                                Text="Remove"
                                                Style="{StaticResource WaveDangerButton}"
                                                Padding="12,8"
                                                VerticalOptions="Center"
                                                Command="{Binding BindingContext.RemoveModFileCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding ModId}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Grid.Row="1"
                            Text="Mods you add will appear here."
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                           Style="{StaticResource WaveCardSubtitle}"
                            FontSize="14"
                            IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                    Binding="{Binding ModFiles.Count}"
                                    Value="0">
                                <Setter Property="IsVisible"
                                        Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Grid Grid.Row="2"
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                Style="{StaticResource WaveSecondaryButton}"
                                Command="{Binding CancelCommand}"/>
                        <Button Grid.Column="1"
                                Text="Save"
                                Style="{StaticResource WavePrimaryButton}"
                                Command="{Binding SaveCommand}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="3"
                Style="{StaticResource WavePanelCard}">
            <Border.Triggers>
                <DataTrigger TargetType="Border"
                        Binding="{Binding HasSearched}"
                        Value="True">
                    <Setter Property="IsVisible"
                            Value="False"/>
                </DataTrigger>
            </Border.Triggers>
            <VerticalStackLayout HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="8">
                <Label Text="Select a mod supplier"
                        Style="{StaticResource WaveSectionTitle}"
                        HorizontalTextAlignment="Center"/>
                <Label Text="Choose a supplier above and search to browse compatible mods."
                       Style="{StaticResource WaveCardSubtitle}"
                        FontSize="14"
                        HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ServersContent.ViewModels"
             xmlns:views="clr-namespace:Wave.Ui.Pages.ServersContent.Views"
             x:Class="Wave.Ui.Pages.ServersContent.Views.HorizontalServerCardView"
             x:Name="Root"
             x:DataType="viewModels:ServerCardViewModel">

    <ContentView.Behaviors>
        <toolkit:EventToCommandBehavior
            x:DataType="viewModels:ServerCardViewModel"
            EventName="Loaded"
            BindingContext="{Binding BindingContext,
                                 Source={x:Reference Root},
                                 x:DataType=views:HorizontalServerCardView}"
            Command="{Binding LoadCommand}"/>
    </ContentView.Behaviors>

    <Border Style="{StaticResource WaveSectionCard}"
            Padding="18,14">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light={StaticResource WaveShadowLight}, Dark={StaticResource Black}}"
                    Offset="0,6"
                    Radius="16"
                    Opacity="0.18"/>
        </Border.Shadow>
        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- LEFT SICE -->
            <Grid Grid.Column="0"
                  ColumnSpacing="14"
                  VerticalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Image -->
                <Border Grid.Column="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        Style="{StaticResource WaveIconWell}">
                    <Image Source="{Binding ServerIcon}"
                           Aspect="AspectFill"/>
                </Border>

                <!-- Text Info -->
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="{Binding Name}"
                           Style="{StaticResource WaveCardTitle}"/>
                    <Label Text="Minecraft server"
                           Style="{StaticResource WaveCardSubtitle}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- RIGHT SIDE-->
            <Grid Grid.Column="1"
                  VerticalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Buttons -->
                <HorizontalStackLayout Grid.Column="0"
                                       Spacing="8"
                                       toolkit:StateContainer.CurrentState="{Binding RunningState}">
                    <toolkit:StateContainer.StateViews>
                        <!-- State Running -->
                        <HorizontalStackLayout toolkit:StateView.StateKey="Running"
                                               Spacing="8">
                            <Button Text="Stop"
                                    Command="{Binding StopServerCommand}"
                                    Style="{StaticResource WaveStopButton}"/>
                            <Button Text="Console"
                                    Command="{Binding OpenServerCommand}"
                                    Style="{StaticResource WaveSecondaryButton}"/>
                        </HorizontalStackLayout>

                        <!-- State Stopped -->
                        <HorizontalStackLayout toolkit:StateView.StateKey="Stopped"
                                               Spacing="8">
                            <Button Text="Start"
                                    Command="{Binding StartServerCommand}"
                                    Style="{StaticResource WaveSuccessButton}"/>
                            <Button Text="Edit"
                                    Command="{Binding EditServerCommand}"
                                    Style="{StaticResource WavePrimaryButton}"/>
                        </HorizontalStackLayout>
                    </toolkit:StateContainer.StateViews>
                </HorizontalStackLayout>
            </Grid>
        </Grid>
    </Border>
</ContentView>

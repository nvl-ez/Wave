<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:Wave.Ui.Pages.ServersContent.ViewModels"
             xmlns:views="clr-namespace:Wave.Ui.Pages.ServersContent.Views"
             x:Class="Wave.Ui.Pages.ServersContent.Views.HorizontalServerCardView"
             x:Name="Root"
             x:DataType="viewModels:ServerCardViewModel">

    <ContentView.Behaviors>
        <toolkit:EventToCommandBehavior
            x:DataType="viewModels:ServerCardViewModel"
            EventName="Loaded"
            BindingContext="{Binding BindingContext,
                                 Source={x:Reference Root},
                                 x:DataType=views:HorizontalServerCardView}"
            Command="{Binding LoadCommand}"/>
    </ContentView.Behaviors>

    <Border Stroke="{AppThemeBinding Light=#DEE6F3, Dark=#313844}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#20242C}"
            Padding="18,14">
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#B7C2D4, Dark=Black}"
                    Offset="0,6"
                    Radius="16"
                    Opacity="0.18"/>
        </Border.Shadow>
        <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- LEFT SICE -->
            <Grid Grid.Column="0"
                  ColumnSpacing="14"
                  VerticalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Image -->
                <Border Grid.Column="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#EAF1FF, Dark=#29344A}">
                    <Image Source="{Binding ServerIcon}"
                           Aspect="AspectFill"/>
                </Border>

                <!-- Text Info -->
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="{Binding Name}"
                           FontAttributes="Bold"
                           FontSize="18"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light=#172033, Dark=#F8FAFC}"/>
                    <Label Text="Minecraft server"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#667085, Dark=#A8B0BF}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- RIGHT SIDE-->
            <Grid Grid.Column="1"
                  VerticalOptions="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Buttons -->
                <HorizontalStackLayout Grid.Column="0"
                                       Spacing="8"
                                       toolkit:StateContainer.CurrentState="{Binding RunningState}">
                    <toolkit:StateContainer.StateViews>
                        <!-- State Running -->
                        <HorizontalStackLayout toolkit:StateView.StateKey="Running"
                                               Spacing="8">
                            <Button Text="Stop"
                                    Command="{Binding StopServerCommand}"
                                    FontAttributes="Bold"
                                    BackgroundColor="#DC2626"
                                    TextColor="White"/>
                            <Button Text="Console"
                                    Command="{Binding OpenServerCommand}"
                                    FontAttributes="Bold"
                                    BackgroundColor="{AppThemeBinding Light=#334155, Dark=#94A3B8}"
                                    TextColor="{AppThemeBinding Light=White, Dark=#111827}"/>
                        </HorizontalStackLayout>

                        <!-- State Stopped -->
                        <HorizontalStackLayout toolkit:StateView.StateKey="Stopped"
                                               Spacing="8">
                            <Button Text="Start"
                                    Command="{Binding StartServerCommand}"
                                    FontAttributes="Bold"
                                    BackgroundColor="#16A34A"
                                    TextColor="White"/>
                            <Button Text="Edit"
                                    Command="{Binding EditServerCommand}"
                                    FontAttributes="Bold"
                                    BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#7CA6FF}"
                                    TextColor="{AppThemeBinding Light=White, Dark=#111827}"/>
                        </HorizontalStackLayout>
                    </toolkit:StateContainer.StateViews>
                </HorizontalStackLayout>
            </Grid>
        </Grid>
    </Border>
</ContentView>

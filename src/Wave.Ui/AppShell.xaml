<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Wave.Ui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:servers="clr-namespace:Wave.Ui.Pages.ServersContent"
    xmlns:settings="clr-namespace:Wave.Ui.Pages.SettingsContent"
    Title="Wave.Ui"
    FlyoutBehavior="Locked">


    <ShellContent
        Route="servers"
        Title="Servers"
        ContentTemplate="{DataTemplate servers:ServersPage}"
        Icon="icon_server.png">
    </ShellContent>

    <ShellContent
        Route="settings"
        Title="Settings"
        ContentTemplate="{DataTemplate settings:SettingsPage}"
        Icon="icon_settings.png"/>


</Shell>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wave.Ui.Views.CollectionComponents.PaginatedCollectionView"
             x:Name="Root">
        <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Collection -->
                <CollectionView Grid.Row="0"
                                ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                                SelectionMode="{Binding SelectionMode, Source={x:Reference Root}}"
                                ItemTemplate="{Binding ItemTemplate, Source={x:Reference Root}}"
                                ItemsLayout="{Binding ItemsLayout, Source={x:Reference Root}}"
                                SelectionChangedCommand="{Binding SelectionChangedCommand, Source={x:Reference Root}}"
                                SelectionChangedCommandParameter="{Binding SelectionChangedCommandParameter, Source={x:Reference Root}}"
                                SelectedItem="{Binding SelectedItem, Source={x:Reference Root}}">

                </CollectionView>

                <Border Grid.Row="1"
                        HorizontalOptions="Center"
                        Style="{StaticResource WaveSoftCard}"
                        Padding="8,6">
                        <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Text="《"
                                        Grid.Column="0"
                                        IsVisible="{Binding IsBeginningVisible, Source={x:Reference Root}}"
                                        Style="{StaticResource WaveIconButton}"
                                        Clicked="Beginning"/>
                                <Button Text="〈"
                                        Grid.Column="1"
                                        IsVisible="{Binding IsPreviousVisible, Source={x:Reference Root}}"
                                        Style="{StaticResource WaveIconButton}"
                                        Clicked="Previous"/>
                                <Label Text="{Binding PageLabel, Source={x:Reference Root}}"
                                       Grid.Column="2"
                                       Margin="12,0"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource WaveTextLight}, Dark={StaticResource WaveTextDark}}"/>
                                <Button Text="〉"
                                        Grid.Column="3"
                                        IsVisible="{Binding IsNextVisible, Source={x:Reference Root}}"
                                        Style="{StaticResource WaveIconButton}"
                                        Clicked="Next"/>
                                <Button Text="》"
                                        Grid.Column="4"
                                        IsVisible="{Binding IsLastVisible, Source={x:Reference Root}}"
                                        Style="{StaticResource WaveIconButton}"
                                        Clicked="End"/>
                        </Grid>
                </Border>
        </Grid>
</ContentView>

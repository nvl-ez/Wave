<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Wave.Ui.Views.ServerPropertyInputView"
             x:Name="Root">

    <VerticalStackLayout
        toolkit:StateContainer.CurrentState="{Binding Source={x:Reference Root}, Path=ServerPropertyType}">
        <toolkit:StateContainer.StateViews>

            <CheckBox toolkit:StateView.StateKey="Boolean"
                      IsChecked="{Binding Source={x:Reference Root}, Path=IsChecked}"/>

            <Picker toolkit:StateView.StateKey="Options"
                    ItemsSource="{Binding Source={x:Reference Root}, Path=Options}"
                    ItemDisplayBinding="{Binding Value}"
                    SelectedIndex="{Binding Source={x:Reference Root}, Path=ListIndex, Mode=TwoWay}"/>

            <Entry toolkit:StateView.StateKey="Integer"
                   Text="{Binding Source={x:Reference Root}, Path=StringValue, Mode=TwoWay}"/>

            <Entry toolkit:StateView.StateKey="String"
                   Text="{Binding Source={x:Reference Root}, Path=StringValue, Mode=TwoWay}"/>

        </toolkit:StateContainer.StateViews>

        <Entry  Text="{Binding Source={x:Reference Root}, Path=StringValue, Mode=TwoWay}"/>
    </VerticalStackLayout>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:serverManager="clr-namespace:Wave.Domain.ServerManager;assembly=Wave.Domain"
             x:Class="Wave.Ui.Views.HorizontalServerCardView"
             x:Name="Root"
             x:DataType="serverManager:ServerInfo">
    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- LEFT SICE -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Image -->
                <BoxView Grid.Column="0"
                         WidthRequest="40"
                         HeightRequest="40"/>

                <!-- Text Info -->
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="{Binding Name}"
                           TextColor="Red"/>
                </VerticalStackLayout>
            </Grid>

            <!-- RIGHT SIDE-->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Buttons -->
                <HorizontalStackLayout Grid.Column="0">
                    <Button Text="Start"
                            Command="{Binding Source={x:Reference Root}, Path=StartServerCommand}"
                            CommandParameter="{Binding Source={x:Reference Root}, Path=ServerCommandParameter}"
                            BackgroundColor="SeaGreen"/>
                    <Button Text="Edit"
                            Command="{Binding Source={x:Reference Root}, Path=EditServerCommand}"
                            CommandParameter="{Binding Source={x:Reference Root}, Path=ServerCommandParameter}"
                            Background="SteelBlue"/>
                </HorizontalStackLayout>

            </Grid>
        </Grid>
    </Border>
</ContentView>
